---
import { withBase } from "@utils/withBase";
import { getCollection } from "astro:content";
import { SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import PageHero from "@components/PageHero.astro";
import GuideCard from "@components/GuideCard.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    eyebrow?: string;
    intro?: string;
    description?: string;
    guidesEyebrow?: string;
    guidesTitle?: string;
    guidesButton?: string;
  };
}

const { frontmatter } = Astro.props;

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title={`About Us | ${SITE.title}`}
  description={frontmatter.description}
>
  <Header activeNav="about" transparent />
  <main id="main-content">
    <PageHero
      eyebrow={frontmatter.eyebrow ?? "About us"}
      title={frontmatter.title}
      intro={frontmatter.intro}
    />
    <section class="container-wide py-16 sm:py-24">
      <article class="prose prose-lg max-w-3xl">
        <slot />
      </article>
    </section>

    <section class="bg-[#050d0f] py-16 sm:py-24">
      <div class="container-wide">
        <p class="eyebrow">{frontmatter.guidesEyebrow ?? "Who we are"}</p>
        <h2 class="section-title">
          {frontmatter.guidesTitle ?? "The guides behind the stars"}
        </h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            guides.slice(0, 6).map(guide => (
              <li>
                <GuideCard guide={guide} compact />
              </li>
            ))
          }
        </ul>
        <div class="mt-10 text-center">
          <a href={withBase("/guides/")} class="btn-primary">
            {
              (frontmatter.guidesButton ?? "Meet all {count} guides").replace(
                "{count}",
                String(guides.length)
              )
            }
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
