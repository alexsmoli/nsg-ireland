---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main id="main-content">
    <div class="not-found-wrapper">
      <h1 aria-label="404 Not Found">404</h1>
      <p>Lost in space — this page drifted out of orbit.</p>
      <a href="/" class="btn-primary mt-8">Back to Earth</a>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  #main-content {
    @apply mx-auto flex max-w-3xl flex-1 px-4 text-center items-center justify-center;
  }
  .not-found-wrapper {
    @apply mb-14 flex flex-col items-center justify-center;
  }
  .not-found-wrapper h1 {
    @apply font-display text-9xl font-extrabold text-star;
  }
  .not-found-wrapper p {
    @apply mt-4 text-xl text-white/80 sm:text-2xl;
  }
</style>
