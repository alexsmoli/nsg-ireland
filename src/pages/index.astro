---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Logo from "@components/Logo.astro";
import Starfield from "@components/Starfield.astro";
import Mountains from "@components/Mountains.astro";
import GuideCard from "@components/GuideCard.astro";
import GuideMap from "@components/GuideMap.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { CONTACT } from "@config";

const posts = getSortedPosts(await getCollection("blog")).slice(0, 3);
const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.order - b.data.order
);

const experiences = [
  {
    title: "Stars & constellations",
    text: "Learn to find your way around the sky — from the Plough to Orion — with the naked eye.",
    icon: "M12 2l2.4 6.9H22l-6 4.6 2.3 7.1L12 16.2 5.7 20.6 8 13.5 2 8.9h7.6z",
  },
  {
    title: "Planets & the Moon",
    text: "Spot the planets wandering among the stars and see craters and rings through a telescope.",
    icon: "M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zm-10 9c4 3 16 3 20-2",
  },
  {
    title: "The Milky Way",
    text: "On a clear, moonless night our galaxy arches across the sky from horizon to horizon.",
    icon: "M3 18C8 14 10 6 21 5M5 20c5-2 9-8 16-9",
  },
  {
    title: "Myths & stories",
    text: "Hear the legends, folklore and science behind the sky our ancestors watched for millennia.",
    icon: "M4 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H4zm16 0h-4a3 3 0 0 0-3 3",
  },
];

const facts = [
  { value: "Gold", label: "Tier dark sky quality" },
  { value: "2014", label: "Designated by DarkSky International" },
  { value: "~700 km²", label: "of protected night sky" },
  { value: "1000s", label: "of stars visible on a clear night" },
];
---

<Layout>
  <Header transparent />
  <main id="main-content">
    <!-- Hero -->
    <section class="hero">
      <Starfield />
      <div class="container-wide hero-content">
        <Logo class="hero-logo" />
        <p class="eyebrow">Night Sky Guides Ireland</p>
        <h1>Discover the Wonders of the&nbsp;Night&nbsp;Sky</h1>
        <p class="hero-sub">
          Guided stargazing with local experts in the Gold Tier Kerry
          International Dark Sky Reserve.
        </p>
        <div class="hero-ctas">
          <a href="#guides" class="btn-primary">Find your guide</a>
          <a href="/dark-sky-reserve/" class="btn-ghost">Explore the reserve</a>
        </div>
      </div>
      <Mountains />
      <a href="#intro" class="scroll-hint" aria-label="Scroll down">
        <span></span>
      </a>
    </section>

    <!-- Intro -->
    <section id="intro" class="section intro">
      <div class="container-wide intro-grid">
        <div>
          <p class="eyebrow">Look up</p>
          <h2 class="section-title">Your journey through the cosmos starts here</h2>
        </div>
        <p class="lead">
          Look up and explore the wonders of the universe with your personal
          Night Sky Guide. Discover stars, constellations, planets, and
          celestial events while learning the secrets and stories behind the
          beauty of the night sky. Whether you're a curious beginner or a
          passionate stargazer, your journey through the cosmos starts here with
          us.
        </p>
      </div>

      <ul class="container-wide experiences">
        {
          experiences.map(item => (
            <li class="card-glass">
              <svg viewBox="0 0 24 24" class="exp-icon" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Guides -->
    <section id="guides" class="section guides">
      <div class="container-wide section-head">
        <div>
          <p class="eyebrow">Who we are</p>
          <h2 class="section-title">Meet your Night Sky Guides</h2>
          <p class="section-intro">
            {guides.length} trained local guides across Kerry — pick the one nearest
            to you or the one who speaks your language.
          </p>
        </div>
        <a href="/guides/" class="btn-ghost hidden sm:inline-flex">All guides</a>
      </div>

      <div class="guide-scroller" tabindex="0" aria-label="Guides">
        {guides.map(guide => <div class="guide-slide"><GuideCard guide={guide} /></div>)}
      </div>

      <div class="container-wide mt-6 sm:hidden">
        <a href="/guides/" class="btn-ghost w-full">See all guides</a>
      </div>

      <div class="container-wide mt-14">
        <h3 class="map-title">Where our guides are</h3>
        <GuideMap guides={guides} />
      </div>
    </section>

    <!-- Reserve -->
    <section id="reserve" class="section reserve">
      <Starfield density={0.6} milkyWay={false} />
      <div class="container-wide reserve-grid">
        <div>
          <p class="eyebrow">Wild Atlantic Way</p>
          <h2 class="section-title">Kerry International Dark Sky Reserve</h2>
          <p class="mt-6 leading-relaxed text-white/80">
            Located along Ireland’s stunning Wild Atlantic Way, the Kerry
            International Dark Sky Reserve is the only Gold Tier dark sky reserve
            in the Northern Hemisphere and offers some of the darkest and most
            spectacular night skies in the world.
          </p>
          <p class="mt-4 leading-relaxed text-white/80">
            Far from the glow of city lights, visitors can admire countless
            stars, spot constellations, and experience the Milky Way stretching
            across the sky. It’s a magical destination for stargazers, nature
            lovers, and anyone wishing to discover the wonders of the universe.
          </p>
          <a href="/dark-sky-reserve/" class="btn-primary mt-8">
            About the reserve
          </a>
        </div>
        <dl class="facts">
          {
            facts.map(fact => (
              <div class="card-glass">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- How it works -->
    <section class="section steps-section">
      <div class="container-wide">
        <p class="eyebrow">Your night out</p>
        <h2 class="section-title">Three steps to the stars</h2>
        <ol class="steps">
          <li>
            <span>01</span>
            <h3>Choose a guide</h3>
            <p>Browse our guides by location and language.</p>
          </li>
          <li>
            <span>02</span>
            <h3>Get in touch</h3>
            <p>Contact your guide directly to plan the date, group and meeting point.</p>
          </li>
          <li>
            <span>03</span>
            <h3>Look up</h3>
            <p>Dress warm, bring curiosity — your guide brings the stories and the stars.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- News -->
    {
      posts.length > 0 && (
        <section class="section news">
          <div class="container-wide section-head">
            <div>
              <p class="eyebrow">News</p>
              <h2 class="section-title">Latest from the dark side</h2>
            </div>
            <a href="/posts/" class="btn-ghost hidden sm:inline-flex">
              All news
            </a>
          </div>
          <ul class="container-wide news-grid">
            {posts.map(({ data, slug }) => (
              <Card href={`/posts/${slug}/`} frontmatter={data} secHeading={false} />
            ))}
          </ul>
          <div class="container-wide mt-6 sm:hidden">
            <a href="/posts/" class="btn-ghost w-full">All news</a>
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <section class="section">
      <div class="container-wide">
        <div class="cta card-glass">
          <div>
            <p class="eyebrow">Become a member</p>
            <h2>Are you a Night Sky Guide?</h2>
            <p>
              Join our network of trained guides and help visitors discover the
              night sky above Kerry.
            </p>
          </div>
          <div class="cta-actions">
            <a href="/membership/" class="btn-primary">Membership</a>
            <a href={`mailto:${CONTACT.email}`} class="btn-ghost">Email us</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .section {
    @apply relative py-16 sm:py-28;
  }
  .section-head {
    @apply mb-10 flex items-end justify-between gap-6;
  }
  .section-intro {
    @apply mt-4 max-w-xl text-white/70;
  }

  /* Hero */
  .hero {
    @apply relative flex min-h-[100svh] items-center overflow-hidden pb-40 pt-24;
  }
  .hero-content {
    @apply relative z-10 flex flex-col items-center text-center;
  }
  .hero :global(.hero-logo) {
    @apply mb-6 h-28 w-auto text-aurora drop-shadow-[0_0_25px_rgba(110,231,168,0.35)] sm:h-36;
  }
  .hero h1 {
    @apply mt-4 max-w-4xl text-[2.6rem] font-extrabold leading-[1.02] tracking-tight text-white sm:text-6xl lg:text-7xl;
  }
  .hero-sub {
    @apply mt-6 max-w-xl text-base text-white/80 sm:text-lg;
  }
  .hero-ctas {
    @apply mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row;
  }
  .scroll-hint {
    @apply absolute bottom-6 left-1/2 z-10 flex h-10 w-6 -translate-x-1/2 justify-center rounded-full border-2 border-white/40;
  }
  .scroll-hint span {
    @apply mt-2 block h-2 w-1 rounded-full bg-white/70;
    animation: scroll-dot 1.8s ease-in-out infinite;
  }
  @keyframes scroll-dot {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /* Intro */
  .intro {
    @apply bg-[#050d0f];
  }
  .intro-grid {
    @apply grid gap-8 lg:grid-cols-2 lg:items-end;
  }
  .lead {
    @apply text-lg leading-relaxed text-white/80;
  }
  .experiences {
    @apply mt-10 grid gap-3 sm:mt-14 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4;
  }
  .experiences li {
    @apply flex gap-4 p-5 sm:block sm:p-6;
  }
  .exp-icon {
    @apply h-10 w-10 shrink-0 rounded-2xl bg-forest/50 fill-none stroke-aurora p-2;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .experiences h3 {
    @apply text-lg sm:mt-5 font-bold text-white;
  }
  .experiences p {
    @apply mt-2 text-sm leading-relaxed text-white/70;
  }

  /* Guides */
  .guides {
    background: linear-gradient(180deg, #050d0f, #07111a);
  }
  .guide-scroller {
    @apply flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:px-6;
    scrollbar-width: thin;
    scroll-padding-inline: 1rem;
  }
  @media (min-width: 1200px) {
    .guide-scroller {
      padding-inline: calc((100vw - 72rem) / 2 + 1.5rem);
      scroll-padding-inline: calc((100vw - 72rem) / 2 + 1.5rem);
    }
  }
  .guide-slide {
    @apply w-[78%] max-w-[300px] shrink-0 snap-start sm:w-[300px];
  }
  .map-title {
    @apply mb-5 text-2xl font-bold text-white;
  }

  /* Reserve */
  .reserve {
    @apply overflow-hidden;
  }
  .reserve-grid {
    @apply relative z-10 grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center;
  }
  .facts {
    @apply grid grid-cols-2 gap-3 sm:gap-4;
  }
  .facts div {
    @apply flex flex-col-reverse p-5 sm:p-6;
  }
  .facts dt {
    @apply mt-1 text-xs leading-snug text-white/60 sm:text-sm;
  }
  .facts dd {
    @apply font-display text-2xl font-extrabold text-star sm:text-4xl;
  }

  /* Steps */
  .steps-section {
    @apply bg-[#050d0f];
  }
  .steps {
    @apply mt-12 grid gap-8 sm:grid-cols-3;
  }
  .steps li {
    @apply relative border-t border-white/15 pt-6;
  }
  .steps span {
    @apply font-display text-sm font-bold tracking-widest text-aurora;
  }
  .steps h3 {
    @apply mt-2 text-2xl font-bold text-white;
  }
  .steps p {
    @apply mt-2 text-white/70;
  }

  /* News */
  .news-grid {
    @apply grid gap-4 sm:grid-cols-2 lg:grid-cols-3;
  }

  /* CTA */
  .cta {
    @apply relative flex flex-col gap-8 overflow-hidden p-8 sm:p-12 lg:flex-row lg:items-center lg:justify-between;
    background:
      radial-gradient(ellipse at 100% 0%, rgba(110, 231, 168, 0.18), transparent 60%),
      radial-gradient(ellipse at 0% 100%, rgba(244, 199, 107, 0.12), transparent 60%),
      rgba(255, 255, 255, 0.04);
  }
  .cta h2 {
    @apply mt-3 text-3xl font-bold text-white sm:text-4xl;
  }
  .cta p:not(.eyebrow) {
    @apply mt-3 max-w-lg text-white/75;
  }
  .cta-actions {
    @apply flex flex-col gap-3 sm:flex-row;
  }
</style>
