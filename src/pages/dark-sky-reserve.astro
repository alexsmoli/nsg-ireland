---
import { withBase } from "@utils/withBase";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PageHero from "@components/PageHero.astro";
import { SITE } from "@config";
import { withBaseHtml } from "@utils/withBase";
import page from "../data/reserve.json";

// All texts are edited in Pages CMS → "Dark Sky Reserve page" (src/data/reserve.json)
---

<Layout
  title={`Kerry International Dark Sky Reserve | ${SITE.title}`}
  description={page.seoDescription}
>
  <Header activeNav="reserve" transparent />
  <main id="main-content">
    <PageHero
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      intro={page.hero.intro}
    />

    <section
      class="container-wide grid gap-12 py-16 sm:py-24 lg:grid-cols-[1.3fr_1fr]"
    >
      <div
        class="space-y-5 text-lg leading-relaxed text-white/80"
        set:html={withBaseHtml(page.body)}
      />
      <aside class="card-glass p-6 sm:p-8">
        <p class="eyebrow">{page.atAGlance.title}</p>
        <dl class="mt-5 space-y-4">
          {
            page.atAGlance.items.map(item => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </section>

    <section class="bg-[#050d0f] py-16 sm:py-24">
      <div class="container-wide">
        <p class="eyebrow">{page.highlights.eyebrow}</p>
        <h2 class="section-title">{page.highlights.title}</h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {
            page.highlights.items.map(item => (
              <li class="card-glass p-6">
                <h3 class="text-xl font-bold text-white">{item.title}</h3>
                <p class="mt-2 text-white/70">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="container-wide py-16 sm:py-24">
      <p class="eyebrow">{page.tips.eyebrow}</p>
      <h2 class="section-title">{page.tips.title}</h2>
      <ol class="tips">
        {
          page.tips.items.map(({ title, text }, i) => (
            <li>
              <span>{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mt-12 flex flex-col gap-3 sm:flex-row">
        <a href={withBase("/guides/")} class="btn-primary"
          >{page.primaryButton}</a
        >
        <a href={withBase("/contact/")} class="btn-ghost"
          >{page.secondaryButton}</a
        >
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  dt {
    @apply text-xs font-semibold uppercase tracking-[0.18em] text-white/50;
  }
  dd {
    @apply mt-0.5 font-display text-lg font-semibold text-white;
  }
  .tips {
    @apply mt-10 grid gap-6 sm:grid-cols-2;
  }
  .tips li {
    @apply flex gap-4;
  }
  .tips span {
    @apply font-display text-3xl font-extrabold text-star/80;
  }
  .tips h3 {
    @apply text-lg font-bold text-white;
  }
  .tips p {
    @apply mt-1 text-white/70;
  }
</style>
