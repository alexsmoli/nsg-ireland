---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import PageHero from "@components/PageHero.astro";
import { CONTACT, SITE } from "@config";

import page from "../data/membership.json";
---

<Layout
  title={`Membership | ${SITE.title}`}
  description={page.seoDescription || undefined}
>
  <Header activeNav="membership" transparent />
  <main id="main-content">
    <PageHero
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      intro={page.hero.intro}
    />

    <section class="container-wide grid gap-10 py-16 sm:py-24 lg:grid-cols-2">
      <div>
        <h2 class="section-title">{page.benefitsTitle}</h2>
        <ul class="mt-8 space-y-4">
          {
            page.benefits.map(benefit => (
              <li class="flex gap-3 text-white/85">
                <svg
                  viewBox="0 0 24 24"
                  class="mt-0.5 h-6 w-6 shrink-0 fill-star"
                  aria-hidden="true"
                >
                  <path d="M12 2l2.4 6.9H22l-6 4.6 2.3 7.1L12 16.2 5.7 20.6 8 13.5 2 8.9h7.6z" />
                </svg>
                <span>{benefit}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card-glass flex flex-col justify-center p-8 sm:p-10">
        <span
          class="w-fit rounded-full bg-forest/60 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-aurora"
        >
          {page.box.badge}
        </span>
        <h3 class="mt-4 text-2xl font-bold text-white">{page.box.title}</h3>
        <p class="mt-3 text-white/70">{page.box.text}</p>
        <a
          href={`mailto:${CONTACT.email}?subject=Membership`}
          class="btn-primary mt-8 w-full sm:w-fit"
        >
          {page.box.button}
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
