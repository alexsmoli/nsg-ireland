---
import { withBase } from "@utils/withBase";
import type { CollectionEntry } from "astro:content";
import { guideContactLinks } from "@utils/guideContacts";

export interface Props {
  guide: CollectionEntry<"guides">;
  showBio?: boolean;
  /** Small avatar next to the name on phones instead of a full-width photo */
  compact?: boolean;
}

const { guide, showBio = false, compact = false } = Astro.props;
const { name, location, languages, contact, photo } = guide.data;
const { Content } = showBio ? await guide.render() : { Content: null };
const contactLinks = guideContactLinks(contact, name);

// Stroke icons (24×24)
const ICONS = {
  email: ["M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z", "M3 7l9 6 9-6"],
  phone: ["M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"],
  instagram: ["M8 4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4z", "M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z", "M16.5 7.5v.01"],
  website: ["M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", "M3.6 9h16.8", "M3.6 15h16.8", "M11.5 3a17 17 0 0 0 0 18", "M12.5 3a17 17 0 0 1 0 18"],
};
---

<article class:list={["guide-card card-glass", { compact }]} id={guide.slug}>
  <div class="photo">
    {
      photo ? (
        <img src={withBase(photo)} alt={`Portrait of ${name}`} loading="lazy" />
      ) : (
        <svg viewBox="0 0 120 120" class="silhouette" aria-hidden="true">
          <circle cx="60" cy="44" r="22" />
          <path d="M18 120c0-26 19-42 42-42s42 16 42 42z" />
        </svg>
      )
    }
  </div>
  <div class="head">
    <h3>{name}</h3>
    <p class="location">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"
        ></path>
      </svg>
      {location}
    </p>
  </div>
  <div class="details">
    <p class="label">Languages</p>
    <p class="langs">
      {languages.map(lang => <span>{lang}</span>)}
    </p>
    {
      Content && (
        <div class="bio">
          <Content />
        </div>
      )
    }
    {
      contactLinks.length > 0 && (
        <ul class="contact" aria-label={`Contact ${name}`}>
          {contactLinks.map(link => (
            <li>
              <a
                href={link.href}
                class="contact-icon"
                aria-label={link.label}
                title={link.label}
                {...(link.external && { target: "_blank", rel: "noopener" })}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {ICONS[link.type].map(d => (
                    <path d={d} />
                  ))}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .guide-card {
    scroll-margin-top: 6rem;
    @apply grid h-full grid-cols-1 grid-rows-[auto_auto_1fr] overflow-hidden transition duration-300 hover:-translate-y-1 hover:border-aurora/40;
  }
  .photo {
    @apply relative aspect-[4/3] overflow-hidden;
    background: radial-gradient(circle at 50% 30%, #1d3b45, #0c1c26 70%);
  }
  .photo img {
    @apply h-full w-full object-cover;
  }
  .silhouette {
    @apply absolute bottom-0 left-1/2 h-[85%] w-auto -translate-x-1/2 fill-[#8a96a0] opacity-70;
  }
  .head {
    @apply px-5 pt-5;
  }
  h3 {
    @apply text-xl font-bold text-white;
  }
  .location {
    @apply mt-1 flex items-center gap-1.5 text-sm text-white/80;
  }
  .location svg {
    @apply h-4 w-4 shrink-0 fill-aurora;
  }
  .details {
    @apply flex flex-col px-5 pb-5 pt-4;
  }
  .label {
    @apply text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-white/50;
  }
  .langs {
    @apply mt-1.5 flex flex-wrap gap-1.5;
  }
  .langs span {
    @apply rounded-full bg-forest/60 px-2.5 py-0.5 text-xs text-aurora;
  }
  .bio {
    @apply mt-4 text-sm leading-relaxed text-white/70;
  }
  .contact {
    @apply mt-auto flex flex-wrap gap-2 pt-5;
  }
  .contact-icon {
    @apply flex h-11 w-11 items-center justify-center rounded-full border border-white/25 bg-white/[0.04] text-white transition hover:-translate-y-0.5 hover:border-star hover:bg-star hover:text-night-950;
  }
  .contact-icon svg {
    @apply h-5 w-5 fill-none stroke-current;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 639px) {
    .compact {
      @apply grid-cols-[6rem_1fr] grid-rows-[auto_1fr] items-center;
    }
    .compact .photo {
      @apply ml-4 mt-4 aspect-square w-20 rounded-2xl;
    }
    .compact .head {
      @apply px-4 pt-4;
    }
    .compact .details {
      @apply col-span-2 self-stretch px-4 pb-4;
    }
  }
</style>
