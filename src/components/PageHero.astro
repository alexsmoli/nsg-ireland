---
import Starfield from "./Starfield.astro";
import Mountains from "./Mountains.astro";

export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <Starfield density={0.8} />
  <div class="container-wide content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
  <Mountains stargazer={false} />
</section>

<style>
  .page-hero {
    @apply relative flex min-h-[52svh] items-end overflow-hidden pb-28 pt-32 sm:min-h-[60vh] sm:pb-36;
  }
  .content {
    @apply relative z-10;
  }
  h1 {
    @apply mt-3 max-w-3xl text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-6xl;
  }
  .intro {
    @apply mt-5 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg;
  }
</style>
