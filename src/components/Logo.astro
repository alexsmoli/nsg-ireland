---
// Vector rebuild of the NSG Ireland logo. Uses currentColor so it works on
// dark and light backgrounds. `mark` renders only the moon & stars.
export interface Props {
  class?: string;
  mark?: boolean;
  title?: string;
}

const { class: className = "", mark = false, title = "NSG Ireland" } =
  Astro.props;

const maskId = `moon-cut-${Math.random().toString(36).slice(2, 8)}`;

const sparkle = (x: number, y: number, r: number) =>
  `M${x} ${y - r}Q${x} ${y} ${x + r} ${y}Q${x} ${y} ${x} ${y + r}Q${x} ${y} ${x - r} ${y}Q${x} ${y} ${x} ${y - r}Z`;

const sparkles: [number, number, number][] = [
  [138, 30, 13],
  [12, 97, 8],
  [52, 150, 7],
  [165, 110, 7],
  [208, 150, 7],
  [324, 64, 9],
  [348, 166, 13],
];

const dipper: [number, number][] = [
  [181, 54],
  [223, 72],
  [258, 102],
  [320, 114],
  [307, 152],
  [260, 140],
];

const dipperPath =
  dipper.map(([x, y], i) => `${i ? "L" : "M"}${x} ${y}`).join("") +
  `L${dipper[2][0]} ${dipper[2][1]}`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={mark ? "0 10 365 170" : "0 10 365 340"}
  class:list={["logo-svg", className]}
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  <defs>
    <mask id={maskId}>
      <rect x="0" y="0" width="200" height="200" fill="white"></rect>
      <circle cx="92" cy="58" r="36" fill="black"></circle>
    </mask>
  </defs>
  <circle cx="72" cy="74" r="42" mask={`url(#${maskId})`} fill="currentColor"
  ></circle>
  {sparkles.map(([x, y, r]) => <path d={sparkle(x, y, r)} fill="currentColor" />)}
  <path
    d={dipperPath}
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linejoin="round"></path>
  {dipper.map(([x, y]) => <circle cx={x} cy={y} r="6.5" fill="currentColor" />)}
  {
    !mark && (
      <>
        <text
          x="178"
          y="275"
          text-anchor="middle"
          fill="currentColor"
          font-family="Outfit, system-ui, sans-serif"
          font-weight="800"
          font-size="118"
          letter-spacing="-2"
        >
          NSG
        </text>
        <text
          x="178"
          y="336"
          text-anchor="middle"
          fill="currentColor"
          font-family="Outfit, system-ui, sans-serif"
          font-weight="600"
          font-size="52"
        >
          Ireland
        </text>
      </>
    )
  }
</svg>

<style>
  .logo-svg {
    fill: currentColor;
  }
</style>
