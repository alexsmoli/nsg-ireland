---
import { withBase } from "@utils/withBase";
import { NAV_LINKS, SITE, type NavKey } from "@config";
import Logo from "./Logo.astro";

export interface Props {
  activeNav?: NavKey | "tags" | "search";
  transparent?: boolean;
}

const { activeNav, transparent = false } = Astro.props;
---

<header
  id="site-header"
  class:list={["site-header", { "is-solid": !transparent }]}
  data-transparent={transparent ? "true" : "false"}
>
  <a id="skip-to-content" href="#main-content">Skip to content</a>
  <div class="container-wide header-inner">
    <a href={withBase("/")} class="brand" aria-label={`${SITE.title} – Home`}>
      <Logo mark class="brand-mark" title="" />
      <span class="brand-text">
        <span class="brand-title">Night Sky Guides</span>
        <span class="brand-sub">Ireland</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      <ul>
        {
          NAV_LINKS.filter(link => link.key !== "contact").map(link => (
            <li>
              <a
                href={withBase(link.href)}
                class:list={{ active: activeNav === link.key }}
                aria-current={activeNav === link.key ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href={withBase("/contact/")} class="btn-primary header-cta">Contact</a>
    </nav>

    <button
      class="menu-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>
<div id="mobile-menu" class="mobile-menu" hidden>
  <nav aria-label="Mobile">
    <ul>
      <li>
        <a href={withBase("/")} class:list={{ active: !activeNav }}>Home</a>
      </li>
      {
        NAV_LINKS.map(link => (
          <li>
            <a
              href={withBase(link.href)}
              class:list={{ active: activeNav === link.key }}
              aria-current={activeNav === link.key ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={withBase("/guides/")} class="btn-primary mt-8 w-full"
      >Find your guide</a
    >
  </nav>
</div>
{!transparent && <div class="h-16 lg:h-20" aria-hidden="true" />}

<style>
  #skip-to-content {
    @apply absolute -top-full left-4 z-[60] rounded-full bg-star px-4 py-2 text-night-950 transition-all focus:top-4;
  }
  .site-header {
    @apply fixed inset-x-0 top-0 z-50 transition-colors duration-300;
    padding-top: env(safe-area-inset-top);
  }
  .site-header.is-solid,
  .site-header.menu-open {
    @apply border-b border-white/10 bg-night-900/85 backdrop-blur-md;
  }
  .header-inner {
    @apply flex h-16 items-center justify-between gap-4 lg:h-20;
  }
  .brand {
    @apply flex items-center gap-3 text-white;
  }
  .brand :global(.brand-mark) {
    @apply h-9 w-auto text-aurora lg:h-11;
  }
  .brand-text {
    @apply flex flex-col leading-none;
  }
  .brand-title {
    @apply font-display text-base font-bold tracking-wide sm:text-lg;
  }
  .brand-sub {
    @apply mt-1 font-display text-[0.7rem] font-semibold uppercase tracking-[0.35em] text-star;
  }

  .desktop-nav {
    @apply hidden items-center gap-6 lg:flex;
  }
  .desktop-nav ul {
    @apply flex items-center gap-1;
  }
  .desktop-nav ul a {
    @apply rounded-full px-3 py-2 text-sm font-medium text-white/80 transition hover:text-white;
  }
  .desktop-nav ul a.active {
    @apply text-star;
  }
  .header-cta {
    @apply min-h-[40px] px-5 py-2 text-sm;
  }

  .menu-toggle {
    @apply relative -mr-2 flex h-12 w-12 flex-col items-center justify-center gap-1.5 lg:hidden;
  }
  .menu-toggle .bar {
    @apply block h-0.5 w-6 rounded bg-white transition duration-300;
  }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .mobile-menu {
    @apply fixed inset-x-0 bottom-0 z-40 overflow-y-auto bg-night-900/95 px-6 pb-10 pt-6 backdrop-blur-lg lg:hidden;
    top: calc(4rem + env(safe-area-inset-top));
    background-image: radial-gradient(
      ellipse at 80% 100%,
      rgba(31, 138, 92, 0.3),
      transparent 60%
    );
  }
  .mobile-menu ul {
    @apply flex flex-col;
  }
  .mobile-menu ul a {
    @apply block border-b border-white/10 py-4 font-display text-2xl font-semibold text-white;
  }
  .mobile-menu ul a.active {
    @apply text-star;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const setOpen = (open: boolean) => {
    if (!toggle || !menu || !header) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.hidden = !open;
    header.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  toggle?.addEventListener("click", () =>
    setOpen(toggle.getAttribute("aria-expanded") !== "true")
  );
  menu
    ?.querySelectorAll("a")
    .forEach(a => a.addEventListener("click", () => setOpen(false)));
  window.addEventListener("keydown", e => e.key === "Escape" && setOpen(false));

  if (header?.dataset.transparent === "true") {
    const onScroll = () =>
      header.classList.toggle("is-solid", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>
