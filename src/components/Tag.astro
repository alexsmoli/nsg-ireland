---
export interface Props {
  tag: string;
  size?: "sm" | "lg";
}

const { tag, size = "sm" } = Astro.props;
---

<li class="inline-block">
  <a
    href={`/tags/${tag}/`}
    class={`${size === "sm" ? "text-sm" : "text-base"} tag-pill`}
  >
    #{tag}
  </a>
</li>

<style>
  .tag-pill {
    @apply inline-flex min-h-[36px] items-center rounded-full border border-white/20 px-4 text-white/80 transition hover:border-star hover:text-star;
  }
</style>
