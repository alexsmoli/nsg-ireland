---
import type { CollectionEntry } from "astro:content";
import { withBase } from "@utils/withBase";
import "leaflet/dist/leaflet.css";

export interface Props {
  guides: CollectionEntry<"guides">[];
  linkBase?: string;
}

const { guides, linkBase = withBase("/guides/") } = Astro.props;

const pins = guides.map(({ slug, data }) => ({
  slug,
  name: data.name,
  location: data.location,
  lat: data.lat,
  lng: data.lng,
}));
---

<div class="map-wrap card-glass">
  <div
    class="guide-map"
    role="region"
    aria-label="Map of guide locations"
    data-pins={JSON.stringify(pins)}
    data-link-base={linkBase}
  >
  </div>
  <button type="button" class="map-activate" hidden>
    <span>Tap to explore the map</span>
  </button>
</div>

<style>
  .map-wrap {
    @apply relative overflow-hidden p-1.5;
  }
  .guide-map {
    @apply h-[400px] w-full rounded-[1.25rem] sm:h-[520px];
    background: #0c1c26;
  }
  .map-activate {
    @apply absolute inset-1.5 z-[500] flex items-end justify-center rounded-[1.25rem] pb-6;
    background: linear-gradient(180deg, transparent 55%, rgba(4, 8, 13, 0.75));
  }
  .map-activate span {
    @apply rounded-full border border-white/40 bg-night-900/90 px-5 py-3 font-display text-sm font-semibold text-white backdrop-blur;
  }
  .guide-map :global(.night-tiles) {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9) saturate(0.6);
  }
  .guide-map :global(.leaflet-popup-content-wrapper),
  .guide-map :global(.leaflet-popup-tip) {
    @apply bg-night-800 text-white;
  }
  .guide-map :global(.leaflet-popup-content-wrapper) {
    @apply rounded-2xl border border-white/15;
  }
  .guide-map :global(.leaflet-popup-content) {
    @apply font-sans text-sm leading-relaxed;
  }
  .guide-map :global(.leaflet-popup-content strong) {
    @apply font-display text-base;
  }
  .guide-map :global(.leaflet-popup-content a) {
    @apply inline-flex min-h-[36px] items-center font-semibold text-star;
  }
  .guide-map :global(.leaflet-container a.leaflet-popup-close-button) {
    @apply h-9 w-9 text-xl leading-9 text-white/70;
  }
  .guide-map :global(.star-pin) {
    @apply flex items-center justify-center rounded-full;
  }
  .guide-map :global(.star-pin span) {
    @apply block h-4 w-4 rounded-full border-2 border-white bg-star transition-transform;
    box-shadow:
      0 0 0 6px rgba(244, 199, 107, 0.25),
      0 0 18px rgba(244, 199, 107, 0.8);
  }
  .guide-map :global(.star-pin:hover span),
  .guide-map :global(.star-pin:focus-visible span) {
    transform: scale(1.3);
  }
  .guide-map :global(.leaflet-bar) {
    @apply overflow-hidden rounded-xl border border-white/20 shadow-none;
  }
  .guide-map :global(.leaflet-bar a) {
    @apply flex h-11 w-11 items-center justify-center border-white/15 bg-night-900/90 text-xl leading-none text-white hover:bg-night-700;
  }
  .guide-map :global(.leaflet-control-attribution) {
    @apply rounded-tl-lg bg-night-900/80 text-white/70;
  }
  .guide-map :global(.leaflet-control-attribution a) {
    @apply text-white/85;
  }
  .guide-map :global(svg) {
    @apply h-auto w-auto;
  }
</style>

<script>
  import L from "leaflet";

  type Pin = { slug: string; name: string; location: string; lat: number; lng: number };

  const escape = (s: string) =>
    s.replace(/[&<>"']/g, c => `&#${c.charCodeAt(0)};`);

  document.querySelectorAll<HTMLElement>(".guide-map").forEach(el => {
    const pins: Pin[] = JSON.parse(el.dataset.pins ?? "[]");
    const linkBase = el.dataset.linkBase ?? "/guides/";
    const touch = window.matchMedia("(pointer: coarse)").matches;
    const map = L.map(el, {
      scrollWheelZoom: false,
      // On phones one-finger drags scroll the page until the map is activated
      dragging: !touch,
      tap: false,
      attributionControl: false,
    } as L.MapOptions);

    L.control
      .attribution({ prefix: '<a href="https://leafletjs.com">Leaflet</a>' })
      .addTo(map);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18,
      className: "night-tiles",
    }).addTo(map);

    const icon = L.divIcon({ className: "star-pin", html: "<span></span>", iconSize: [44, 44] });
    const markers = pins.map(pin =>
      L.marker([pin.lat, pin.lng], { icon, title: pin.name, alt: pin.name })
        .bindPopup(
          `<strong>${escape(pin.name)}</strong><br>${escape(pin.location)}<br><a href="${linkBase}#${pin.slug}">View guide →</a>`
        )
        .addTo(map)
    );

    const activate = el.parentElement?.querySelector<HTMLButtonElement>(".map-activate");
    if (touch && activate) {
      activate.hidden = false;
      activate.addEventListener("click", () => {
        map.dragging.enable();
        activate.hidden = true;
      });
    }

    const fit = () => {
      map.invalidateSize();
      if (markers.length) {
        map.fitBounds(L.featureGroup(markers).getBounds(), { padding: [30, 30] });
      } else {
        map.setView([51.9, -10.0], 9);
      }
    };
    fit();
    // Re-fit once the container has its final size (fonts/CSS may load late)
    let fitted = false;
    new ResizeObserver(() => {
      if (!fitted) {
        fitted = true;
        fit();
      }
    }).observe(el);
    window.addEventListener("load", fit, { once: true });
  });
</script>
