---
import { withBase } from "@utils/withBase";
import { CONTACT, NAV_LINKS, SITE } from "@config";
import Logo from "./Logo.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["site-footer", { "mt-auto": !noMarginTop }]}>
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <a href={withBase("/")} aria-label={`${SITE.title} – Home`}>
        <Logo class="h-28 w-auto text-aurora" />
      </a>
      <p>
        Local guides to some of the darkest skies in Europe — stars, stories and
        unforgettable nights on Ireland's Wild Atlantic Way.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        {
          NAV_LINKS.map(link => (
            <li>
              <a href={withBase(link.href)}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2>Get in touch</h2>
      <ul>
        <li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
        {
          CONTACT.phone && (
            <li>
              <a href={`tel:${CONTACT.phone}`}>{CONTACT.phone}</a>
            </li>
          )
        }
        <li class="text-white/60">{CONTACT.region}</li>
      </ul>
      <Socials />
    </div>
  </div>
  <div class="container-wide footer-bottom">
    <span>&copy; {currentYear} {SITE.title}</span>
    <span>Keep it dark. Look up.</span>
  </div>
</footer>

<style>
  .site-footer {
    @apply w-full border-t border-white/10 bg-night-950 pt-14;
    padding-bottom: env(safe-area-inset-bottom);
  }
  .footer-grid {
    @apply grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1.3fr];
  }
  .footer-brand p {
    @apply mt-4 max-w-sm text-sm leading-relaxed text-white/60;
  }
  h2 {
    @apply mb-4 font-display text-sm font-semibold uppercase tracking-[0.2em] text-star;
  }
  ul {
    @apply space-y-2 text-sm;
  }
  ul a {
    @apply text-white/80 transition hover:text-aurora;
  }
  .footer-bottom {
    @apply mt-12 flex flex-col gap-2 border-t border-white/10 py-6 text-xs text-white/50 sm:flex-row sm:justify-between;
  }
  .site-footer :global(.social-icons) {
    @apply mt-4 justify-start;
  }
</style>
